{
  "manifest_version": 3,
  "name": "Emoji Keys",
  "version": "1.1.0",
  "description": "Animated A-Z emoji keyboard effects and optional emoji replacement for webpage text fields.",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html", "default_title": "Emoji Keys" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
